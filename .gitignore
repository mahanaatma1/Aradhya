# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Aradhya content pipeline.
# Comments go on their own line: git has no inline comment, so
# "content/raw/    # downloaded scans" is a pattern ending in the word "scans"
# and matches nothing. These three read as ignored for months and were not.
# downloaded public-domain scans; reproducible via the sha256 in registry.jsonl
content/raw/
# report.html + build logs
content/build/
# CM-04: retained build snapshots (each carries a full gyan.sqlite copy) --
# these are a local/CI rollback mechanism, not something to version in git
content/builds/
# stale flutter asset build markers
assets/db/build/

# Flutter run/build noise that was previously committed at the repo root
flutter_*.log
flutter_*.png
# 38 MB duplicate of the bundled DB — regenerate, never commit
assets/db/*.bak

# Wikidata skeletons awaiting editorial work (see content/tools/extract.py)
content/staging/

# Shipped DB assets are generated by content/tools/build.py, not authored.
assets/db/*.sqlite.gz

# Secrets — never commit API keys
.env
.env.*
