{
  "name": "aradhya-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aradhya — public knowledge layer and discovery gateway for the Aradhya mobile app.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:ssr && node scripts/generate-sitemap.mjs && node scripts/prerender.mjs",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "build:debug": "vite build --config vite.config.debug.js && npm run build:ssr && node scripts/generate-sitemap.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "serve": "node scripts/serve-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "og": "node scripts/make-og-image.mjs",
    "content": "py scripts/extract-content.py"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
