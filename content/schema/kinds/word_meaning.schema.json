{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aradhya:word_meaning",
  "title": "RD-02 Word meaning tab — a word-by-word gloss of one scripture verse",
  "type": "object",
  "properties": {
    "scripture_ref": {
      "type": "string",
      "description": "'bhagavad-gita:2.47' -- resolved against scripture_sections the same way ask.scripture_ref is."
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sanskrit": {
            "type": "string",
            "minLength": 1,
            "description": "IAST, e.g. 'karmani'. Diacritics kept -- this is a study aid, not prose."
          },
          "meaning": { "$ref": "aradhya:_common#/$defs/bilingual" },
          "order_no": { "type": "integer" }
        },
        "required": ["sanskrit", "meaning", "order_no"],
        "additionalProperties": false
      }
    },
    "sources": { "$ref": "aradhya:_common#/$defs/sources" },
    "verification": { "$ref": "aradhya:_common#/$defs/verification" }
  },
  "required": ["scripture_ref", "words", "sources", "verification"],
  "additionalProperties": false
}
