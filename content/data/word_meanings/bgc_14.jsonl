{"scripture_ref": "bhagavad-gita:14.15", "words": [{"sanskrit": "rajasi pralayam gatva", "meaning": {"en": "having died while passion (dominated)", "hi": "रज में मृत्यु पाकर"}, "order_no": 1}, {"sanskrit": "karma-sangishu jayate", "meaning": {"en": "is born among those attached to action", "hi": "कर्म-आसक्त लोगों में जन्म लेता है"}, "order_no": 2}, {"sanskrit": "tatha pralinah tamasi", "meaning": {"en": "likewise, dissolved while inertia (dominated)", "hi": "उसी तरह तम में लीन होकर"}, "order_no": 3}, {"sanskrit": "mudha-yonishu jayate", "meaning": {"en": "is born into wombs of the deluded, into dull species", "hi": "मूढ़ योनियों में जन्म लेता है"}, "order_no": 4}], "sources": [{"source_slug": "telang-bhagavadgita", "source_chapter_or_section": "14.15", "is_primary": true, "last_verified_at": "2026-09-14", "verified_by": "AI-researched, unreviewed"}], "verification": {"status_en": "verified", "status_hi": "verified", "by": "AI-researched, unreviewed", "at": "2026-09-14", "notes": "Word-by-word gloss read against the verse's own Sanskrit; each entry is a plain-language meaning, not a grammatical parse."}}
